{
  "name": "nexus-portal-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "ng serve",
    "prebuild": "npm run audit:icons",
    "build": "ng build",
    "test": "ng test",
    "lint": "eslint \"src/**/*.{ts,html}\"",
    "audit:icons": "node scripts/audit-lucide-icons.mjs",
    "lint:fix": "eslint \"src/**/*.{ts,html}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,html,css,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,scss,json}\"",
    "prepare": "husky",
    "storybook": "ng run nexus-portal-web:storybook",
    "build-storybook": "ng run nexus-portal-web:build-storybook",
    "extract-i18n": "ng extract-i18n",
    "analyze": "ng build --source-map && source-map-explorer dist/nexus-portal-web/browser/*.js",
    "api:generate": "openapi-ts && prettier --write \"src/app/api/generated/**/*.ts\"",
    "api:check": "npm run api:generate && git diff --exit-code -- src/app/api/generated openapi/nexus-portal-api.json",
    "e2e": "playwright test",
    "a11y:routes": "playwright test e2e/a11y.spec.ts",
    "lighthouse:ci": "lhci autorun",
    "pree2e": "npm run audit:icons",
    "test-storybook": "test-storybook --url http://localhost:6006"
  },
  "lint-staged": {
    "src/**/*.{ts,html}": [
      "eslint --fix"
    ],
    "src/**/*.{ts,html,css,scss,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@angular/animations": "^21.2.17",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.17",
    "@angular/compiler": "^21.2.17",
    "@angular/core": "^21.2.17",
    "@angular/forms": "^21.2.17",
    "@angular/localize": "^21.2.17",
    "@angular/platform-browser": "^21.2.17",
    "@angular/router": "^21.2.17",
    "@angular/service-worker": "^21.2.17",
    "@tailwindcss/postcss": "^4.3.1",
    "diff": "^9.0.0",
    "lucide-angular": "^1.0.0",
    "marked": "^18.0.5",
    "ngx-editor": "^19.0.0-beta.1",
    "prosemirror-model": "^1.25.7",
    "rxjs": "^7.8.1",
    "tailwindcss": "^4.3.1",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2102.0",
    "@angular-devkit/build-angular": "^21.2.15",
    "@angular-devkit/core": "^21.2.0",
    "@angular-eslint/eslint-plugin": "^22.0.0",
    "@angular-eslint/eslint-plugin-template": "^22.0.0",
    "@angular-eslint/template-parser": "^22.0.0",
    "@angular/cli": "^21.2.15",
    "@angular/compiler-cli": "^21.2.17",
    "@angular/platform-browser-dynamic": "^21.2.17",
    "@axe-core/playwright": "^4.11.3",
    "@compodoc/compodoc": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "^10.4.4",
    "@storybook/addon-docs": "^10.4.4",
    "@storybook/angular": "^10.4.4",
    "@storybook/test-runner": "^0.24.4",
    "@types/diff": "^7.0.2",
    "@types/jasmine": "^5.1.15",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.4.4",
    "husky": "^9.1.7",
    "jasmine-core": "^5.13.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "lint-staged": "^17.0.7",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "serve": "^14.2.4",
    "source-map-explorer": "^2.5.3",
    "storybook": "^10.4.4",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.61.0"
  }
}
